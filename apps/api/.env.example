# Application Environment (development | production)
APP_NAME="PolyMind"
ENVIRONMENT="production"
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# Allowed CORS Origins (on Render, use "*" or your frontend URL like https://your-web.onrender.com)
CORS_ORIGINS="*"

# Free-Tier Provider API Keys (Set these securely in Render's Environment Variables dashboard)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
